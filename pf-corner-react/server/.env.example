# ---------------------------------------------------------------------------
# PF Corner notification server — copy this file to ".env" and fill it in.
# Anything left blank can also be set later from the admin panel
# (Notifications → Save to server).
# ---------------------------------------------------------------------------

PORT=3000

# Who may call this server. Use your website address in production,
# for example https://pfcorner.in  — "*" allows any site.
ALLOWED_ORIGIN=*

# --- admin sign in -----------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS=change-this-password
# A long random string. The admin panel sends it with every settings change.
ADMIN_TOKEN=paste-a-long-random-string-here

# --- email (Gmail app password) ---------------------------------------------
# 1. Google Account → Security → turn on 2-Step Verification
# 2. Security → App passwords → choose "Mail" → copy the 16 characters
# 3. Paste them below WITHOUT spaces. Your normal Gmail password will not work.
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
GMAIL_USER=pfcorner100@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
MAIL_FROM_NAME=PF Corner
ADMIN_EMAIL=pfcorner100@gmail.com
ADMIN_CC=
AUTO_REPLY=true

# --- WhatsApp Cloud API (optional) ------------------------------------------
# From developers.facebook.com → your app → WhatsApp → API setup
WA_ENABLED=false
WA_MODE=cloud
WA_PHONE_ID=
WA_TOKEN=
WA_ADMIN_NUMBER=918380920789

# --- SMS (optional) ----------------------------------------------------------
# SMS_PROVIDER = twilio | fast2sms | msg91
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_ADMIN_NUMBER=918380920789
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# --- Telegram (optional) -----------------------------------------------------
TG_ENABLED=false
TG_BOT_TOKEN=
TG_CHAT_ID=
